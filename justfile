PKG := "paramix"
VERSION := `Rscript -e "cat(read.dcf('DESCRIPTION')[,'Version'])"`
TARBALL := PKG + "_" + VERSION + ".tar.gz"

default: format lint docs test

[unix]
[doc('Clean up auxiliary files and directories')]
clean:
	rm -rf *.tar.gz *.Rcheck .Rproj.user figure figures doc Meta vignettes/*.html vignettes/*.pdf vignettes/figures/*.svg vignettes/figures/*.pdf vignettes/figures/*.png

[doc('Ensure local NAMESPACE exists (bootstrapped if missing)')]
bootstrap-namespace:
	#!/usr/bin/env Rscript
	if (!file.exists("NAMESPACE")) {
	  writeLines(c("# Generated by roxygen2: do not edit by hand", "exportPattern(\"^[[:alpha:]]+\")"), "NAMESPACE")
	}

[doc('Regenerate roxygen output: man/*.Rd, NAMESPACE, and R/globals.R (all untracked)')]
docs: bootstrap-namespace
	#!/usr/bin/env Rscript
	Sys.setlocale("LC_COLLATE", "C")
	if (require(roxygen2)) roxygen2::roxygenize() else stop("missing 'roxygen2'")

[doc('Format R code using air')]
format:
	air format .

[doc('Check R code using air and lintr')]
lint: lintair lintr

[doc('Check R code using air')]
lintair:
	air format . --check

[doc('Check R code using lintr')]
lintr: bootstrap-namespace
	#!/usr/bin/env Rscript
	if (require(lintr)) lintr::lint_package() else stop("missing 'lintr'")

[doc('Run unit tests using devtools')]
test: bootstrap-namespace
	#!/usr/bin/env Rscript 
	library(devtools)
	devtools::test()

[doc('Run unit tests using devtools, stopping on first failure')]
test-fast filter="": bootstrap-namespace
	#!/usr/bin/env Rscript
	library(devtools)
	filter_arg <- trimws("{{ filter }}")
	if (nzchar(filter_arg)) {
	  devtools::test(filter = filter_arg, stop_on_failure = TRUE)
	} else {
	  devtools::test(stop_on_failure = TRUE)
	}

[doc('Check test coverage using covr')]
coverage: bootstrap-namespace
	#!/usr/bin/env Rscript
	if (require(covr)) print(covr::package_coverage()) else stop("missing 'covr'")

[doc('Check spelling across documentation and vignettes using spelling')]
spell: bootstrap-namespace
	#!/usr/bin/env Rscript
	if (require(spelling)) spelling::spell_check_package() else stop("missing 'spelling'")

[doc('Install development version of package')]
install: bootstrap-namespace docs
	R CMD INSTALL .

[group('analysis')]
[doc('Verify that the bundled demonstration analysis runs and produces all outputs from the installed package')]
test-analysis jobs="4": install
	#!/usr/bin/env bash
	set -euo pipefail
	TMP_DIR=$(mktemp -d)
	trap 'rm -rf "${TMP_DIR}"' EXIT

	echo "==> Extracting bundled analysis pipeline from installed paramix..."
	Rscript -e '
	  src <- system.file("analysis", package = "paramix")
	  if (!nzchar(src) || !dir.exists(src)) {
	    stop("Analysis directory not found in installed paramix package.")
	  }
	  dest <- commandArgs(trailingOnly = TRUE)[1]
	  files <- list.files(src, full.names = TRUE, recursive = FALSE, include.dirs = TRUE)
	  file.copy(from = files, to = dest, recursive = TRUE)
	' "${TMP_DIR}"

	echo "==> Running reproduction pipeline in ${TMP_DIR} with make -j{{ jobs }}..."
	make -C "${TMP_DIR}" -j{{ jobs }}

	echo "==> Verifying expected output products..."
	test -f "${TMP_DIR}/figure/summary.png" || { echo "Missing figure/summary.png"; exit 1; }
	test -f "${TMP_DIR}/figure/incidence.png" || { echo "Missing figure/incidence.png"; exit 1; }
	test -f "${TMP_DIR}/figure/averted.png" || { echo "Missing figure/averted.png"; exit 1; }
	test -f "${TMP_DIR}/figure/yll.png" || { echo "Missing figure/yll.png"; exit 1; }
	test -f "${TMP_DIR}/output/consolidated.rds" || { echo "Missing output/consolidated.rds"; exit 1; }
	test -f "${TMP_DIR}/output/incidence.rds" || { echo "Missing output/incidence.rds"; exit 1; }
	echo "==> Analysis verified successfully!"


[doc('Remove development version of package')]
remove:
	R CMD REMOVE {{ PKG }}

[doc('Build a tar.gz artifact')]
build: bootstrap-namespace docs
	R CMD build .

[doc('Check the built tar.gz artifact')]
check: build
	R CMD check {{ TARBALL }} --no-manual --no-tests

[doc('Check the built tar.gz artifact using CRAN settings')]
check-cran: build
	R CMD check {{ TARBALL }} --as-cran

[doc('Render vignettes to PDF and HTML locally')]
render: bootstrap-namespace
	#!/usr/bin/env Rscript
	if (!require(rmarkdown)) stop("missing 'rmarkdown'")
	if (require(devtools)) devtools::load_all(quiet = TRUE)
	files <- list.files("vignettes", pattern = "\\.Rmd$", full.names = TRUE)
	for (f in files) {
	  message("Rendering ", f, " to HTML...")
	  rmarkdown::render(f, output_format = "html_document", quiet = TRUE)
	  message("Rendering ", f, " to PDF...")
	  rmarkdown::render(f, output_format = "pdf_document", quiet = TRUE)
	}

[group('site')]
[doc('Fast build of pkgdown documentation site into docs/ (no package reinstallation)')]
site: bootstrap-namespace docs
	#!/usr/bin/env Rscript
	if (!requireNamespace("pkgdown", quietly = TRUE)) stop("missing 'pkgdown'")
	options(pkgdown.internet = FALSE)
	pkgdown::build_site_github_pages(new_process = FALSE, install = FALSE)

[group('site')]
[doc('Alias for just site (fast documentation build)')]
site-quick: site

[group('site')]
[doc('Full build of pkgdown site with package reinstallation so vignettes see updated data/code')]
site-full: bootstrap-namespace docs install
	#!/usr/bin/env Rscript
	if (!requireNamespace("pkgdown", quietly = TRUE)) stop("missing 'pkgdown'")
	options(pkgdown.internet = FALSE)
	pkgdown::build_site_github_pages(new_process = FALSE, install = FALSE)

[group('site')]
[doc('Preview pkgdown documentation on localhost; optionally specify a vignette/article item to re-render (e.g. just site-preview intro)')]
site-preview item="" port="8000": bootstrap-namespace docs
	#!/usr/bin/env Rscript
	if (!requireNamespace("pkgdown", quietly = TRUE)) stop("missing 'pkgdown'")
	if (!requireNamespace("httpuv", quietly = TRUE)) stop("missing 'httpuv'")
	options(pkgdown.internet = FALSE)

	item <- trimws("{{ item }}")
	port_num <- as.integer("{{ port }}")
	url_path <- ""

	if (nzchar(item)) {
	  clean_item <- tools::file_path_sans_ext(basename(item))

	  if (identical(clean_item, "all")) {
	    message("Re-building entire pkgdown site...")
	    pkgdown::build_site_github_pages(new_process = FALSE, install = FALSE)
	  } else if (identical(clean_item, "reference")) {
	    message("Re-building reference index and documentation...")
	    pkgdown::build_reference()
	    url_path <- "reference/index.html"
	  } else if (clean_item %in% c("home", "index", "readme")) {
	    message("Re-building home page...")
	    pkgdown::build_home()
	    url_path <- "index.html"
	  } else {
	    message(sprintf("Targeted build for article '%s'...", clean_item))
	    pkgdown::build_article(clean_item)
	    url_path <- sprintf("articles/%s.html", clean_item)
	  }
	} else {
	  message("Re-building entire pkgdown site...")
	  pkgdown::build_site_github_pages(new_process = FALSE, install = FALSE)
	}

	target_url <- sprintf("http://127.0.0.1:%d/%s", port_num, url_path)
	message(sprintf("Serving pkgdown site at %s (Ctrl+C to stop)", target_url))
	httpuv::runStaticServer(
	  dir = "docs",
	  host = "127.0.0.1",
	  port = port_num,
	  browse = interactive() || nzchar(Sys.getenv("BROWSER"))
	)

[group('git')]
[doc('Fetch, prune remote tracking references, and delete merged local branches (including squash-merged PRs)')]
prune-branches:
	#!/usr/bin/env bash
	set -euo pipefail
	git fetch --prune
	merged=$(git branch --merged main | grep -v '^\*\|main' || true)
	gone=$(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2 == "[gone]" && $1 != "main" {print $1}' || true)
	to_delete=$(echo -e "${merged}\n${gone}" | sed '/^$/d' | sort -u || true)
	if [ -n "$to_delete" ]; then
		echo "Pruning merged / stale local branches:"
		echo "$to_delete"
		echo "$to_delete" | xargs -r git branch -D
	else
		echo "No merged or stale local branches to prune."
	fi
