# Test artifacts
tests/*.Rout*

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata
.DS_Store

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes and intermediate knitr artifacts
vignettes/*.html
vignettes/*.pdf
vignettes/*_files/
*_files/

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown or R interactive sessions
*.utf8.md
*.knit.md
Rplots.pdf

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
.Rproj.user
inst/doc
/doc/
/Meta/
docs
man/alembic.tex

# Regenerated by roxygen2() in CI: man pages and the roxyglobals-managed
# R/globals.R are documentation-process outputs, so the build regenerates them
# rather than tracking them. Every workflow that builds, installs, or checks the
# package runs `roxygen2::roxygenise()` first (which bootstraps a missing
# NAMESPACE). man/figures/ stays tracked because curated assets like logos
# aren't roxygen output.
man/*.Rd
R/globals.R
.bin/

